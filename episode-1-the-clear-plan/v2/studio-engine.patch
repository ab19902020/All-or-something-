+def rider(x, ceiling):
+    """a gain curve holding every 400 ms of x at or under `ceiling` (LUFS, momentary): it starts to dip 200 ms ahead
+    of a loud moment and lets go over 300 ms, so a boom or a swell comes down whole rather than being chopped"""
+    hop = SR // 100
+    y = _k_weight(np.asarray(x, np.float64))
+    p = (y ** 2).sum(1) if y.ndim == 2 else y ** 2
+    c = np.concatenate([[0.0], np.cumsum(p)])
+    w = int(0.4 * SR)
+    idx = np.arange(0, len(p), hop)
+    a, b = np.clip(idx - w // 2, 0, len(p)), np.clip(idx + w // 2, 0, len(p))
+    ms = (c[b] - c[a]) / np.maximum(1, b - a)
+    g = np.minimum(0.0, ceiling - (-0.691 + 10 * np.log10(ms + 1e-12)))
+    from scipy.ndimage import minimum_filter1d, uniform_filter1d
+    g = uniform_filter1d(minimum_filter1d(g, 41), 30)
+    return db(np.interp(np.arange(len(p)) / hop, np.arange(len(g)), g)).astype(np.float32)
+
+
+def soft_limit(x, peak_db=-1.0, knee_db=-7.0):
+    """untouched below the knee; above it, a smooth curve that never passes the peak"""
+    pk, kn = db(peak_db), db(knee_db)
+    a = np.abs(x)
+    over = a > kn
+    y = x.copy()
+    y[over] = np.sign(x[over]) * (kn + (pk - kn) * np.tanh((a[over] - kn) / (pk - kn)))
+    return y
+
